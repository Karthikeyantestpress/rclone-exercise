# Local-only S3 credentials. Copy to .env (gitignored) and change the secrets:
#   cp .env.example .env
# docker-compose.yml and scripts/s3-servers.sh read this file to start the
# two S3 endpoints; the experiments and transfer.sh read it from the
# environment. Credentials never live in git or in the scripts.

# Endpoint A ("provider A")
S3_A_ENDPOINT=http://127.0.0.1:9000
S3_A_ACCESS_KEY=provider-a-key
S3_A_SECRET_KEY=change-me-provider-a

# Endpoint B ("provider B"), deliberately different credentials
S3_B_ENDPOINT=http://127.0.0.1:9100
S3_B_ACCESS_KEY=provider-b-key
S3_B_SECRET_KEY=change-me-provider-b
