# Example credentials file for `transfer.sh --env-file`.
# In production this file would be a mounted secret (Kubernetes Secret,
# Docker secret, Vault agent output) or the variables would be injected by
# the process manager; it is never committed with real values.
#
# This example builds two named remotes from the local .env values:
#   transfer.sh --env-file transfer.env.example copy providera:bucket providerb:bucket
# (it is sourced by bash, so ${VAR} references are expanded)

RCLONE_CONFIG_PROVIDERA_TYPE=s3
RCLONE_CONFIG_PROVIDERA_PROVIDER=Other
RCLONE_CONFIG_PROVIDERA_ENDPOINT=${S3_A_ENDPOINT}
RCLONE_CONFIG_PROVIDERA_ACCESS_KEY_ID=${S3_A_ACCESS_KEY}
RCLONE_CONFIG_PROVIDERA_SECRET_ACCESS_KEY=${S3_A_SECRET_KEY}

RCLONE_CONFIG_PROVIDERB_TYPE=s3
RCLONE_CONFIG_PROVIDERB_PROVIDER=Other
RCLONE_CONFIG_PROVIDERB_ENDPOINT=${S3_B_ENDPOINT}
RCLONE_CONFIG_PROVIDERB_ACCESS_KEY_ID=${S3_B_ACCESS_KEY}
RCLONE_CONFIG_PROVIDERB_SECRET_ACCESS_KEY=${S3_B_SECRET_KEY}
