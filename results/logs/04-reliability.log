==================== 5. Retries while the server goes away ====================
# server A is killed (SIGKILL) 3s into a 100MB upload and restarted 6s later; -vv shows the retry messages
# --low-level-retries retries individual HTTP requests; --retries re-runs the whole sync for files that still failed

$ ( sleep 3; kill_a; echo ">>> $(date +%T) server A killed"; sleep 6; restart_a; echo ">>> $(date +%T) server A restarted" ) &
rclone copy data/source/videos/lecture-100MB.bin :s3:big/retry/ --bwlimit 10M --retries 5 --retries-sleep 3s --low-level-retries 3 --timeout 5s --contimeout 2s -vv --stats 0 2>&1 | grep -E "low level retry|Attempt|Failed to copy|Copied" | cut -c1-170
wait
>>> 10:22:37 server A killed
>>> 10:22:44 server A restarted
