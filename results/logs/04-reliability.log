
==================== 1. Upload a 1GB file (multipart) ====================
# files above --s3-upload-cutoff (200M default) go up as multipart: chunks uploaded in parallel

$ time rclone copy data/big/upload-1GB.bin :s3:big/single/ --s3-chunk-size 64M --s3-upload-concurrency 4 --stats 5s --stats-one-line -v
2026/11/02 10:22:20 INFO  :         1 GiB / 1 GiB, 100%, 241.125 MiB/s, ETA 0s
2026/11/02 10:22:22 INFO  : upload-1GB.bin: Multi-thread Copied (new)
2026/11/02 10:22:22 INFO  :         1 GiB / 1 GiB, 100%, 170.667 MiB/s, ETA 0s
elapsed: 5.583s

$ rclone ls :s3:big/single
1073741824 upload-1GB.bin
# multipart ETags are not plain MD5s; rclone stores the MD5 as object metadata, so check still verifies content

$ rclone check data/big :s3:big/single
2026/11/02 10:22:23 NOTICE: S3 bucket big path single: 0 differences found
2026/11/02 10:22:23 NOTICE: S3 bucket big path single: 1 matching files

==================== 2. Concurrent transfers (--transfers) ====================
# 6 x 25MB files, one at a time vs. all six in parallel

$ time rclone copy data/reliability :s3:big/t1 --exclude upload-1GB.bin --transfers 1 --stats-one-line --stats 0
elapsed: 1.101s

$ time rclone copy data/reliability :s3:big/t6 --exclude upload-1GB.bin --transfers 6 --stats-one-line --stats 0
elapsed: 0.377s
# with network latency per request (real S3), more transfers hide latency; on loopback the disk/CPU dominate

==================== 3. Bandwidth limit (--bwlimit) ====================

$ time rclone copy data/source/videos/lecture-100MB.bin :s3:big/bw/ --bwlimit 20M --stats 2s --stats-one-line -v
2026/11/02 10:22:25 INFO  : Starting bandwidth limiter at 20Mi Byte/s
2026/11/02 10:22:27 INFO  :    40.027 MiB / 100 MiB, 40%, 20.089 MiB/s, ETA 2s
2026/11/02 10:22:29 INFO  :    80.059 MiB / 100 MiB, 80%, 20.019 MiB/s, ETA 0s
2026/11/02 10:22:30 INFO  : lecture-100MB.bin: Copied (new)
2026/11/02 10:22:30 INFO  :       100 MiB / 100 MiB, 100%, 20.000 MiB/s, ETA 0s
elapsed: 5.296s
# 100MB at 20MiB/s should take ~5s. --bwlimit also takes a timetable, e.g. "08:00,5M 19:00,off"

