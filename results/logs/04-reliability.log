$ rclone check data/source/videos :s3:big/retry
2026/11/02 10:22:52 NOTICE: S3 bucket big path retry: 0 differences found
2026/11/02 10:22:52 NOTICE: S3 bucket big path retry: 1 matching files

==================== 6. Interrupted transfer, then restart ====================
# simulate a crash: SIGKILL rclone 15s into uploading 6x25MB + 1GB (no chance to clean up)

$ timeout -s KILL 15 rclone copy data/reliability :s3:big/resume --transfers 2 --bwlimit 40M -v --stats 0 2>&1 | grep -E "Copied|ERROR"
2026/11/02 10:22:53 INFO  : part-2-25MB.bin: Copied (new)
2026/11/02 10:22:53 INFO  : part-1-25MB.bin: Copied (new)
2026/11/02 10:22:55 INFO  : part-3-25MB.bin: Copied (new)
2026/11/02 10:22:55 INFO  : part-4-25MB.bin: Copied (new)
2026/11/02 10:22:56 INFO  : part-5-25MB.bin: Copied (new)
2026/11/02 10:22:56 INFO  : part-6-25MB.bin: Copied (new)

$ rclone ls :s3:big/resume   # what made it before the crash
 26214400 part-1-25MB.bin
 26214400 part-2-25MB.bin
 26214400 part-3-25MB.bin
 26214400 part-4-25MB.bin
 26214400 part-5-25MB.bin
 26214400 part-6-25MB.bin
# the half-uploaded 1GB file is not visible as an object, but its parts sit on the server as an unfinished multipart upload

$ rclone backend list-multipart-uploads :s3:big
{
	"big": [
		{
			"ChecksumAlgorithm": "",
			"ChecksumType": "",
			"Initiated": "2026-11-02T04:52:57.645Z",
			"Initiator": null,
			"Key": "resume/upload-1GB.bin",
			"Owner": null,
			"StorageClass": "STANDARD",
			"UploadId": "39560d10-e6ca-4835-8ef1-6af211c05ded"
		}
	]
}
# restart the same command: finished files are skipped (only checked), unfinished ones transferred

$ time rclone copy data/reliability :s3:big/resume --transfers 2 -v --stats 0 2>&1 | grep -E "Copied|ERROR|nothing to transfer"
2026/11/02 10:23:17 INFO  : upload-1GB.bin: Multi-thread Copied (new)
elapsed: 10.494s

$ rclone check data/reliability :s3:big/resume
2026/11/02 10:23:19 NOTICE: S3 bucket big path resume: 0 differences found
2026/11/02 10:23:20 NOTICE: S3 bucket big path resume: 7 matching files
# abandoned multipart parts cost storage on real S3: clean them up (or use a bucket lifecycle rule)

$ rclone backend cleanup :s3:big -o max-age=0s

$ rclone backend list-multipart-uploads :s3:big
{
	"big": []
}

