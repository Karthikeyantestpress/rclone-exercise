$ cmp data/source/videos/lecture-100MB.bin data/downloaded/lecture-100MB.bin && echo "100MB file: byte-identical"
100MB file: byte-identical

==================== 5. Copy between two buckets (same endpoint) ====================
# both buckets live on the same server, so rclone asks the server to copy (no data through this machine)

$ rclone copy :s3:videos :s3:backups -v
2026/11/02 10:17:24 INFO  : docs/readme.txt: Copied (server-side copy)
2026/11/02 10:17:24 INFO  : pdfs/invoice-001.pdf: Copied (server-side copy)
2026/11/02 10:17:24 INFO  : docs/notes/2026/meeting-notes.txt: Copied (server-side copy)
2026/11/02 10:17:24 INFO  : docs/notes/2026/todo.txt: Copied (server-side copy)
2026/11/02 10:17:24 INFO  : pdfs/reports/q3-report.pdf: Copied (server-side copy)
2026/11/02 10:17:25 INFO  : videos/lecture-100MB.bin: Copied (server-side copy)
2026/11/02 10:17:25 INFO  : 
Transferred:   	  100.001 MiB / 100.001 MiB, 100%, 0 B/s, ETA -
Checks:                 0 / 0, -, Listed 12
Transferred:            6 / 6, 100%
Server Side Copies:     6 @ 100.001 MiB
Elapsed time:         0.5s


$ rclone check :s3:videos :s3:backups
2026/11/02 10:17:25 NOTICE: S3 bucket backups: 0 differences found
2026/11/02 10:17:25 NOTICE: S3 bucket backups: 6 matching files
# upload integrity: local file MD5 vs object ETag (MD5) on the server

$ rclone check data/source :s3:videos
2026/11/02 10:17:25 NOTICE: S3 bucket videos: 0 differences found
2026/11/02 10:17:25 NOTICE: S3 bucket videos: 6 matching files

==================== 6. Delete objects ====================

$ rclone deletefile :s3:backups/docs/readme.txt -v              # one object
2026/11/02 10:17:25 INFO  : readme.txt: Deleted

$ rclone delete :s3:backups --include "*.pdf" -v                # by filter
2026/11/02 10:17:25 INFO  : pdfs/invoice-001.pdf: Deleted
2026/11/02 10:17:25 INFO  : pdfs/reports/q3-report.pdf: Deleted

$ rclone lsf -R :s3:backups
docs/notes/2026/meeting-notes.txt
docs/notes/2026/todo.txt
videos/lecture-100MB.bin
docs/
docs/notes/
docs/notes/2026/
videos/

$ rclone purge :s3:backups -v                                   # all objects + the bucket
2026/11/02 10:17:26 INFO  : docs/notes/2026/meeting-notes.txt: Deleted
2026/11/02 10:17:26 INFO  : docs/notes/2026/todo.txt: Deleted
2026/11/02 10:17:26 INFO  : videos/lecture-100MB.bin: Deleted
2026/11/02 10:17:26 INFO  : S3 bucket backups: Bucket "backups" deleted

$ rclone lsd :s3:
          -1 2026-11-02 10:17:21        -1 videos
