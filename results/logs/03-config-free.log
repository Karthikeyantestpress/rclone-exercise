
==================== 0. Prove there is no usable config ====================

$ rclone config file
Configuration is in memory only

$ ls -l ~/.config/rclone/rclone.conf 2>&1   # the default path does not exist either
ls: cannot access '/home/karthik/.config/rclone/rclone.conf': No such file or directory
(exit code 2)
# an explicitly EMPTY config file works the same way:

$ rclone --config data/empty-rclone.conf listremotes; echo "remotes defined: $(rclone --config data/empty-rclone.conf listremotes | wc -l)"
remotes defined: 0

==================== A. On-the-fly connection string ====================
# every setting inside the remote name; values containing : or , must be quoted

$ rclone --config data/empty-rclone.conf mkdir ":s3,provider=Other,endpoint='$S3_A_ENDPOINT',access_key_id=$S3_A_ACCESS_KEY,secret_access_key=$S3_A_SECRET_KEY:config-free"

$ rclone --config data/empty-rclone.conf copy data/source/pdfs ":s3,provider=Other,endpoint='$S3_A_ENDPOINT',access_key_id=$S3_A_ACCESS_KEY,secret_access_key=$S3_A_SECRET_KEY:config-free/via-connection-string" -v
2026/11/02 10:18:26 INFO  : invoice-001.pdf: Copied (new)
2026/11/02 10:18:26 INFO  : reports/q3-report.pdf: Copied (new)
2026/11/02 10:18:26 INFO  : 
Transferred:   	    1.166 KiB / 1.166 KiB, 100%, 0 B/s, ETA -
Checks:                 0 / 0, -, Listed 3
Transferred:            2 / 2, 100%
Elapsed time:         0.0s

# downside: the secret is part of the command line -> visible in ps, shell history, CI logs

==================== B. Backend flags ====================

$ rclone --config data/empty-rclone.conf lsf -R :s3:config-free --s3-provider Other --s3-endpoint "$S3_A_ENDPOINT" --s3-access-key-id "$S3_A_ACCESS_KEY" --s3-secret-access-key "$S3_A_SECRET_KEY"
via-connection-string/invoice-001.pdf
via-connection-string/reports/q3-report.pdf
via-connection-string/
via-connection-string/reports/
# same downside as A: secrets in argv

==================== C. Environment variables for the unnamed :s3: backend ====================
# every --s3-xxx flag can be given as RCLONE_S3_XXX

$ export RCLONE_S3_PROVIDER=Other RCLONE_S3_ENDPOINT="$S3_A_ENDPOINT" RCLONE_S3_ACCESS_KEY_ID="$S3_A_ACCESS_KEY" RCLONE_S3_SECRET_ACCESS_KEY="$S3_A_SECRET_KEY"

$ rclone --config data/empty-rclone.conf copy data/source/docs :s3:config-free/via-env -v
