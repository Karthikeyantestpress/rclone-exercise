5 directories, 5 files
# limitation: only ONE set of :s3: settings at a time

$ clear_s3_env

==================== D. Named remotes defined only by environment variables ====================
# RCLONE_CONFIG_<NAME>_<OPTION> creates remote <name>: in memory. Two providers, two credential sets, at once:

$ export RCLONE_CONFIG_PROVA_TYPE=s3 RCLONE_CONFIG_PROVA_PROVIDER=Other RCLONE_CONFIG_PROVA_ENDPOINT="$S3_A_ENDPOINT" RCLONE_CONFIG_PROVA_ACCESS_KEY_ID="$S3_A_ACCESS_KEY" RCLONE_CONFIG_PROVA_SECRET_ACCESS_KEY="$S3_A_SECRET_KEY"

$ export RCLONE_CONFIG_PROVB_TYPE=s3 RCLONE_CONFIG_PROVB_PROVIDER=Other RCLONE_CONFIG_PROVB_ENDPOINT="$S3_B_ENDPOINT" RCLONE_CONFIG_PROVB_ACCESS_KEY_ID="$S3_B_ACCESS_KEY" RCLONE_CONFIG_PROVB_SECRET_ACCESS_KEY="$S3_B_SECRET_KEY"

$ rclone --config data/empty-rclone.conf listremotes   # remotes exist, yet the config file is empty
prova:
provb:

$ rclone --config data/empty-rclone.conf mkdir provb:replica

==================== E. Different credentials + endpoints in ONE operation ====================
# copy endpoint A -> endpoint B: each side authenticates with its own keys

$ rclone --config data/empty-rclone.conf copy prova:config-free provb:replica -v
2026/11/02 10:18:27 INFO  : via-connection-string/invoice-001.pdf: Copied (new)
2026/11/02 10:18:27 INFO  : via-env/readme.txt: Copied (new)
2026/11/02 10:18:27 INFO  : via-connection-string/reports/q3-report.pdf: Copied (new)
